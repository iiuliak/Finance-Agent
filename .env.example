# Copy to .env. Docker Compose reads it automatically.
# For a local run without Docker, export these in your shell instead.

# The demo date. The app never reads the wall clock.
AS_OF_DATE=2026-11-15

# "template" answers from the books without any model (no key needed).
# "openai" uses any OpenAI-compatible chat completions API.
LLM_MODE=template

# Groq, free key at https://console.groq.com:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=openai/gpt-oss-120b

# OpenAI (OPENAI_BASE_URL defaults to https://api.openai.com/v1):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama on your machine, no key needed:
# OPENAI_BASE_URL=http://localhost:11434/v1             # local run
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1  # inside Docker
# OPENAI_MODEL=llama3.1

# Local run only. Docker sets its own database URL.
# DATABASE_URL=postgresql+psycopg://vat:vat@localhost:5433/vat
